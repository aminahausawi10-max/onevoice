# ========================================================
# Signals by PressOne Programmable Voice API Credentials
# ========================================================
# Retrieve these credentials from your PressOne console:
# https://pressone.africa under Developers > Voice Account
# Note: Use your Voice Account SID and Voice Auth Token

PRESSONE_ACCOUNT_SID=AC_YOUR_PRESSONE_ACCOUNT_SID
PRESSONE_AUTH_TOKEN=YOUR_VOICE_AUTH_TOKEN
PRESSONE_FROM_NUMBER=+234XXXXXXXXXX
PRESSONE_BASE_URL=https://api.signals.pressone.africa

# Webhook Host (Auto-detected if not specified)
APP_BASE_URL=https://one-voice-orpin.vercel.app

# Optional Neon PostgreSQL Connection
DATABASE_URL=
